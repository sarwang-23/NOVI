# Database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/novi_db

# Auth0
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.novi.com
AUTH0_CLIENT_ID=your_client_id
AUTH0_CLIENT_SECRET=your_client_secret

# App
APP_BASE_URL=http://localhost:3000
PORT=8000

# AI/ML Service (handled by separate team)
AIML_API_URL=http://localhost:9000
AIML_API_KEY=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@novi.com
SMTP_FROM_NAME=Novi Platform

# Push Notifications (FCM)
FCM_SERVER_KEY=
FCM_SENDER_ID=

# File Storage (local | s3 | gcs)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads

# AWS S3 (if using s3 backend)
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# Google Cloud Storage (if using gcs backend)
GCS_BUCKET=
GCS_PROJECT_ID=

# Database Pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
SQL_ECHO=false

# Webhook Secrets (for verifying incoming webhooks)
WEBHOOK_SECRET_CLEVER=
WEBHOOK_SECRET_POWERSCHOOL=
WEBHOOK_SECRET_CANVAS=
